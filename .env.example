# --- Database ---
# Any Postgres connection string works: Neon, Supabase, Railway, Render, RDS,
# or your own server. Local dev example:
DATABASE_URL="postgresql://user:password@localhost:5432/bab_tasker"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Set this to your deployed URL in production, e.g. https://app.yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# --- Super admin account (used once by prisma/seed.ts) ---
# This is you, managing every customer business from /admin. Must be a
# different email than OWNER_EMAIL below — they're two separate accounts.
SUPER_ADMIN_NAME="Samantha (Admin)"
SUPER_ADMIN_EMAIL="admin@babcleaningservices.com"
SUPER_ADMIN_PASSWORD="change-this-before-you-seed"

# --- Your own business's first account (used once by prisma/seed.ts) ---
# This creates organization #1 so you can use the product yourself before
# selling it to anyone else. No jobs/employees are seeded — add them from
# the app once you're logged in.
OWNER_NAME="Samantha"
OWNER_EMAIL="babcleaning@outlook.com"
OWNER_PASSWORD="change-this-before-you-seed"
OWNER_ORG_NAME="BAB Cleaning"

# --- Twilio (SMS notifications to cleaners) ---
# Create a free trial account at https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Cron ---
# Any random string. The reminder sweep endpoint requires this as a Bearer
# token so only your scheduler can trigger it.
CRON_SECRET="replace-with-another-random-string"

# Minutes before a job's start time to send the "time for your clean" text.
REMINDER_MINUTES_BEFORE="30"

# --- Stripe (billing for businesses buying BAB Tasker) ---
# From your Stripe Dashboard: Developers > API keys.
STRIPE_SECRET_KEY=""
# From Developers > Webhooks, after adding an endpoint pointing at
# https://<your-domain>/api/webhooks/stripe listening for at least:
# checkout.session.completed, invoice.payment_failed, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=""

# --- /get-started marketing page ---
# Your own cell number. When someone submits the contact form, you get a
# text with their info — nothing is stored in the database.
LEAD_NOTIFY_PHONE=""
