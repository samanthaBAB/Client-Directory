# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/cleaning_marketplace"

# Long random string used to sign mobile-app auth JWTs (openssl rand -base64 32)
JWT_SECRET="change-me"

# Stripe (Connect enabled account)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Where Stripe redirects a cleaner after onboarding (deep link back into the cleaner app)
STRIPE_CONNECT_REFRESH_URL="https://your-api-domain.com/api/stripe/connect/refresh"
STRIPE_CONNECT_RETURN_URL="cleanerapp://stripe-onboarding-complete"
