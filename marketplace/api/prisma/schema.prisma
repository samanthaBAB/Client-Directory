generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  HOMEOWNER
  CLEANER
  ADMIN
}

enum JobStatus {
  PENDING     // posted, waiting for a cleaner to accept
  ACCEPTED    // a cleaner accepted it
  IN_PROGRESS // cleaner started the clean
  COMPLETED   // cleaner marked it done
  CANCELED    // homeowner canceled before/after acceptance
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  phone           String?
  role            Role
  pushToken       String?
  // Account-level enforcement (see CLEANER_POLICIES in src/lib/catalog.ts):
  // canceling an accepted job within 24h of the scheduled time, or a
  // reported no-show, disables the account. Checked on every authenticated
  // request (src/lib/auth.ts), not just at login, so a disable takes
  // effect immediately even on an already-issued token.
  disabled        Boolean  @default(false)
  disabledReason  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  homeownerProfile HomeownerProfile?
  cleanerProfile   CleanerProfile?

  reviewsGiven    Review[] @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")
}

model HomeownerProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?

  // Paid monthly membership (MONTHLY_SUBSCRIPTION_PRICE_CENTS in
  // src/lib/catalog.ts): unlimited cleanings that month, each still billed
  // separately at a 25% discount. subscriptionStatus mirrors Stripe's
  // subscription status ("active", "past_due", "canceled", etc.) via
  // webhook (src/app/api/webhooks/stripe/route.ts) — treat "active" as
  // the only status that actually grants the discount.
  stripeSubscriptionId String?
  subscriptionStatus   String?

  addresses   Address[]
  jobRequests JobRequest[]
}

model CleanerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio               String?
  hourlyRateCents   Int      @default(4000)
  serviceRadiusMi   Int      @default(15)
  baseLat           Float?
  baseLng           Float?
  stripeAccountId   String?
  stripeOnboarded   Boolean  @default(false)
  ratingAvg         Float?
  ratingCount       Int      @default(0)

  jobRequests JobRequest[]
}

model Address {
  id        String  @id @default(cuid())
  homeownerId String
  homeowner HomeownerProfile @relation(fields: [homeownerId], references: [id], onDelete: Cascade)
  line1     String
  line2     String?
  city      String
  state     String
  zip       String
  lat       Float?
  lng       Float?
  notes     String?

  jobRequests JobRequest[]
}

model JobRequest {
  id              String    @id @default(cuid())
  homeownerId     String
  homeowner       HomeownerProfile @relation(fields: [homeownerId], references: [id], onDelete: Cascade)
  addressId       String
  address         Address   @relation(fields: [addressId], references: [id])
  cleanerId       String?
  cleaner         CleanerProfile? @relation(fields: [cleanerId], references: [id])

  serviceType     String    // catalog id, e.g. "residential", "deep" — see src/lib/catalog.ts
  squareFootage   Int       // priced per sq ft — see PRICE_PER_SQFT_CENTS in src/lib/catalog.ts
  bedroomCount    Int?      // null for "commercial" (sq-ft-only pricing)
  bathroomCount   Float?    // allows .5 for a half bath; null for "commercial"
  kitchenCount    Int?      // null for "commercial"
  extras          String[]  @default([]) // catalog ids of selected add-on tasks — see src/lib/catalog.ts
  scheduledFor    DateTime
  // priceCents is the final, already-discounted amount actually charged —
  // discountLabel/discountCents record what was applied and why, computed
  // once at booking time and never recomputed later (see computeDiscount
  // in src/lib/catalog.ts). NOTE: the cleaner's payout is 85% of this
  // (discounted) priceCents, same split as any job — a promo currently
  // reduces the cleaner's payout proportionally along with the platform's
  // cut, rather than the platform absorbing it alone. Revisit if that's
  // not the intent.
  priceCents      Int
  discountLabel   String?
  discountCents   Int       @default(0)
  notes           String?
  status          JobStatus @default(PENDING)

  payment         Payment?
  review          Review?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([cleanerId])
  @@index([homeownerId])
}

model Payment {
  id                    String        @id @default(cuid())
  jobRequestId          String        @unique
  jobRequest            JobRequest    @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  stripePaymentIntentId String        @unique
  amountCents           Int
  status                PaymentStatus @default(REQUIRES_PAYMENT)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model JobDecline {
  id           String   @id @default(cuid())
  jobRequestId String
  cleanerId    String
  createdAt    DateTime @default(now())

  @@unique([jobRequestId, cleanerId])
}

model Review {
  id           String     @id @default(cuid())
  jobRequestId String     @unique
  jobRequest   JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  rating       Int
  comment      String?
  fromUserId   String
  fromUser     User       @relation("ReviewsGiven", fields: [fromUserId], references: [id])
  toUserId     String
  toUser       User       @relation("ReviewsReceived", fields: [toUserId], references: [id])
  createdAt    DateTime   @default(now())
}
