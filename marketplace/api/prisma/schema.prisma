generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  HOMEOWNER
  CLEANER
}

enum JobStatus {
  PENDING     // posted, waiting for a cleaner to accept
  ACCEPTED    // a cleaner accepted it
  IN_PROGRESS // cleaner started the clean
  COMPLETED   // cleaner marked it done
  CANCELED    // homeowner canceled before/after acceptance
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role
  pushToken    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  homeownerProfile HomeownerProfile?
  cleanerProfile   CleanerProfile?

  reviewsGiven    Review[] @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")
}

model HomeownerProfile {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId String?

  addresses   Address[]
  jobRequests JobRequest[]
}

model CleanerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio               String?
  hourlyRateCents   Int      @default(4000)
  serviceRadiusMi   Int      @default(15)
  baseLat           Float?
  baseLng           Float?
  stripeAccountId   String?
  stripeOnboarded   Boolean  @default(false)
  ratingAvg         Float?
  ratingCount       Int      @default(0)

  jobRequests JobRequest[]
}

model Address {
  id        String  @id @default(cuid())
  homeownerId String
  homeowner HomeownerProfile @relation(fields: [homeownerId], references: [id], onDelete: Cascade)
  line1     String
  line2     String?
  city      String
  state     String
  zip       String
  lat       Float?
  lng       Float?
  notes     String?

  jobRequests JobRequest[]
}

model JobRequest {
  id              String    @id @default(cuid())
  homeownerId     String
  homeowner       HomeownerProfile @relation(fields: [homeownerId], references: [id], onDelete: Cascade)
  addressId       String
  address         Address   @relation(fields: [addressId], references: [id])
  cleanerId       String?
  cleaner         CleanerProfile? @relation(fields: [cleanerId], references: [id])

  serviceType     String    // e.g. "standard", "deep", "move-out"
  scheduledFor    DateTime
  estimatedHours  Float     @default(2)
  priceCents      Int
  notes           String?
  status          JobStatus @default(PENDING)

  payment         Payment?
  review          Review?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([cleanerId])
  @@index([homeownerId])
}

model Payment {
  id                    String        @id @default(cuid())
  jobRequestId          String        @unique
  jobRequest            JobRequest    @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  stripePaymentIntentId String        @unique
  amountCents           Int
  status                PaymentStatus @default(REQUIRES_PAYMENT)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model JobDecline {
  id           String   @id @default(cuid())
  jobRequestId String
  cleanerId    String
  createdAt    DateTime @default(now())

  @@unique([jobRequestId, cleanerId])
}

model Review {
  id           String     @id @default(cuid())
  jobRequestId String     @unique
  jobRequest   JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  rating       Int
  comment      String?
  fromUserId   String
  fromUser     User       @relation("ReviewsGiven", fields: [fromUserId], references: [id])
  toUserId     String
  toUser       User       @relation("ReviewsReceived", fields: [toUserId], references: [id])
  createdAt    DateTime   @default(now())
}
