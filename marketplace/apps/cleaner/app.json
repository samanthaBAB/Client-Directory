{
  "expo": {
    "name": "Suds & Scrub Pro",
    "slug": "suds-and-scrub-cleaner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "sudsandscrub",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sudsandscrub.cleaner",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to show you cleaning jobs near you."
      }
    },
    "android": {
      "package": "com.sudsandscrub.cleaner",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We use your location to show you cleaning jobs near you."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://your-api-domain.com"
    }
  }
}
