{
  "expo": {
    "name": "Suds & Scrub",
    "slug": "suds-and-scrub-homeowner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#241934"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sudsandscrub.homeowner",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to find cleaners near your home and to prefill your address."
      }
    },
    "android": {
      "package": "com.sudsandscrub.homeowner",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#241934"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "plugins": [
      "@stripe/stripe-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We use your location to find cleaners near your home and to prefill your address."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://your-api-domain.com",
      "stripePublishableKey": "pk_test_..."
    }
  }
}
