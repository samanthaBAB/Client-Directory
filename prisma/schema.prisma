generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  EMPLOYEE
}

enum VisitStatus {
  IN_PROGRESS
  COMPLETED
}

enum OrgStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

// Assigning a job means offering it — the cleaner must accept before it's
// really theirs. This keeps the business from directing exactly who does
// what work, which matters for staying a 1099 relationship rather than W-2.
enum AssignmentStatus {
  NONE
  PENDING
  ACCEPTED
}

// One row per cleaning business that has bought the product. SUPER_ADMIN
// users (the platform's own operator) belong to no organization; every
// other user and every job belongs to exactly one.
model Organization {
  id                String    @id @default(cuid())
  name              String
  propertyLimit     Int
  monthlyPriceCents Int
  status            OrgStatus @default(ACTIVE)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  users User[]
  jobs  Job[]

  @@map("organizations")
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  phone          String?
  passwordHash   String
  role           Role          @default(EMPLOYEE)
  mustChangePw   Boolean       @default(true)
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedJobs Job[]         @relation("AssignedJobs")
  visits       Visit[]

  @@index([organizationId])
  @@map("users")
}

model Job {
  id                String   @id @default(cuid())
  organizationId    String
  customer          String
  property          String?
  serviceType       String?
  address           String?
  city              String?
  state             String?
  price             String?
  payout            String?
  phone             String?
  schedule          String?
  // Structured recurrence, used to compute which calendar days a job falls
  // on. `schedule` above stays as the auto-generated human-readable text
  // (e.g. "Every Mon/Wed/Fri") so existing display code doesn't need to
  // know about recurrence at all.
  recurrenceType     String?  // "ONCE" | "WEEKLY" | "BIWEEKLY" | "MONTHLY_NTH"
  recurrenceDays     Int[]    @default([]) // 0=Sun..6=Sat
  recurrenceOrdinals Int[]    @default([]) // MONTHLY_NTH only: 1-4, or -1 for "last"
  recurrenceAnchor   String?  // ONCE: the date "YYYY-MM-DD"; BIWEEKLY: any date on an "on" week
  startTime         String?
  endTime           String?
  sameDayCheckIn    Boolean  @default(false)
  accessCode        String?
  keyLocation       String?
  suppliesLocation  String?
  ownerNote         String?
  damageNote        String?
  notes             String?
  assignedToId      String?
  assignmentStatus  AssignmentStatus @default(NONE)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?          @relation("AssignedJobs", fields: [assignedToId], references: [id], onDelete: SetNull)
  photos       Photo[]
  visits       Visit[]
  reminders    JobReminder[]

  @@index([organizationId])
  @@map("jobs")
}

model Photo {
  id         String   @id @default(cuid())
  jobId      String
  dataUrl    String   @db.Text
  uploadedAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("photos")
}

model Visit {
  id             String      @id @default(cuid())
  jobId          String?
  jobLabel       String
  employeeId     String
  date           String
  status         VisitStatus @default(IN_PROGRESS)
  startedAt      DateTime?
  endedAt        DateTime?
  note           String?
  sameDayCheckIn Boolean     @default(false)
  createdAt      DateTime    @default(now())

  job      Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  employee User @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("visits")
}

// Tracks whether a "time for your clean" reminder text has already gone out
// for a given job on a given day, so the cron sweep never double-texts.
model JobReminder {
  id       String   @id @default(cuid())
  jobId    String
  date     String
  sentAt   DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, date])
  @@map("job_reminders")
}
